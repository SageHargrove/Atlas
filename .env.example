# ---- App auth (required) ----
# MUST be long + random. In production the server refuses to start without it.
# Also derives the encryption key for bank tokens at rest â€” if you change it,
# users must re-connect their banks (existing sessions also drop).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=any-long-random-string
# Friends/family need this code to register (first account never needs it). Rotate anytime.
INVITE_CODE=make-something-up

# ---- Passkeys (WebAuthn) ----
# Required for passkey login in production. RP_ID is your bare domain (no https://,
# no port); RP_ORIGIN is the full origin. Passwords + recovery codes still work if unset.
# Local dev can leave these blank (defaults: localhost + http://localhost:5173).
RP_ID=atlas.YOUR-IP.nip.io
RP_ORIGIN=https://atlas.YOUR-IP.nip.io

# Set BOTH of these on any real deployment. NODE_ENV=production makes the server
# refuse to start without a strong SESSION_SECRET; FORCE_SECURE_COOKIE stops the
# 30-day session cookie from ever being sent over plain HTTP.
NODE_ENV=production
FORCE_SECURE_COOKIE=1

# ---- Bank connections ----
# SimpleFIN needs no configuration here at all — you paste a one-time setup token
# into the app (Accounts tab) and the server exchanges it. Nothing to set up.
#
# Teller withdrew its API in July 2026. New connections are impossible, so leave
# the block below empty unless you still hold a working enrollment and want the
# legacy sync path to keep running until their servers go dark.
#TELLER_ENV=development
#TELLER_CERT_PATH=./certs/certificate.pem
#TELLER_KEY_PATH=./certs/private_key.pem

# ---- AI (optional â€” auto-categorize + review) ----
# Get a key at https://console.anthropic.com â€” leave blank to disable AI features
ANTHROPIC_API_KEY=
# Hard daily caps on AI calls so an accident/loop can't drain your API bill.
# Each call is bounded (~$0.02 worst case), so 200/day â‰ˆ a few dollars max.
AI_DAILY_LIMIT=200
AI_USER_DAILY_LIMIT=100

PORT=3001

# --- Push notifications (optional) ---
# Alerts for income landing, a low balance, a new subscription, a bill coming due.
# Generate a key pair with:  npx web-push generate-vapid-keys
# Leave these unset and the alerts panel simply says push isn't configured.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com
